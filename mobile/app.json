{
  "expo": {
    "name": "Attendance Mobile",
    "slug": "attendance-poc-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#172554"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app requires camera access to scan office attendance QR codes."
      }
    },
    "android": {
      "package": "com.company.attendancepoc",
      "adaptiveIcon": {
        "backgroundColor": "#172554"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Attendance Mobile to access your camera to scan office QR codes."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9f6511ff-77ee-4130-b684-a75a219c84cc"
      }
    }
  }
}
