# ==============================================================================
# EMPLOYEE ATTENDANCE AUTOMATION - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' and fill in your actual credentials.
# NOTE: '.env' is ignored by Git and must never be committed.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration (Managed via phpMyAdmin)
# Replace these dummy placeholders with your actual MySQL database credentials
DB_HOST=localhost
DB_PORT=3306
DB_NAME=attendance_poc_db
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_CONNECTION_LIMIT=10

# Security & Authentication
# Generate a secure 32+ character string for JWT signing
JWT_SECRET=replace_with_a_secure_random_secret_minimum_32_characters
JWT_EXPIRES_IN=24h

# QR Token Rotation Engine
# Secret key used for signing/hashing rotating office QR codes
QR_SECRET=replace_with_a_secure_hmac_secret_for_qr_signing
QR_ROTATION_INTERVAL_SECONDS=30
QR_GRACE_PERIOD_SECONDS=15

# Office Attendance Rules
OFFICE_TIMEZONE=Asia/Kolkata
WORKDAY_REVIEW_CUTOFF_HOUR=14
WORKDAY_END_HOUR=23

# Client Origins (CORS)
CLIENT_URL=http://localhost:3000

