{
  "name": "attendance-poc-backend",
  "version": "1.0.0",
  "description": "Unified Node.js/Express API for Employee Attendance Automation",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "db:migrate": "ts-node-dev src/db/migrate.ts",
    "test:db": "ts-node test/db.test.ts",
    "test:auth": "ts-node test/auth.test.ts",
    "test:qr": "ts-node test/qr.test.ts",
    "test:attendance": "ts-node test/attendance.test.ts",
    "test:correction": "ts-node test/correction.test.ts",
    "test:mobile": "ts-node test/mobileApi.test.ts",
    "test": "npm run test:db && npm run test:auth && npm run test:qr && npm run test:attendance && npm run test:correction && npm run test:mobile"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}

